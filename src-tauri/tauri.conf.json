{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShowU",
  "version": "0.1.0",
  "identifier": "com.showu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShowU · 项目记忆工作区",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
